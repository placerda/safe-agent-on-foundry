FOUNDRY_PROJECT_ENDPOINT=https://your-resource.services.ai.azure.com/api/projects/your-project
AZURE_AI_MODEL_DEPLOYMENT_NAME=gpt-5.4-mini
# Optional. Defaults to "safe". Set to "vulnerable" only for the demo comparison.
# HELPDESKBOT_MODE=safe
SAFE_EVIDENCE_SECRET=replace-with-at-least-32-random-characters
# Records prompts, tool arguments, tool results, and final responses in traces.
# Set to false when testing with sensitive or production data.
OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT=true
# Optional, local runs only. In a hosted deployment, Foundry injects this for
# you, but only after you create an Application Insights resource and attach it
# to the project as a connection. See "See ACS decisions in Application
# Insights" in the README. azd does not create that resource.
# APPLICATIONINSIGHTS_CONNECTION_STRING=InstrumentationKey=...
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
