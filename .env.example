# =============================================================================
# 1. HelpdeskBot runtime (the agent under test)
# =============================================================================
FOUNDRY_PROJECT_ENDPOINT=https://your-resource.services.ai.azure.com/api/projects/your-project
AZURE_AI_MODEL_DEPLOYMENT_NAME=gpt-5.4-mini
# Optional. Defaults to "safe". Set to "vulnerable" only for the demo comparison.
# HELPDESKBOT_MODE=safe
SAFE_EVIDENCE_SECRET=replace-with-at-least-32-random-characters
# Hosted main() enforces false before instrumentation initializes.
# ASSERT emits its separate sanitized fictional trajectory for evaluation.
OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT=false
# Optional, local runs only. In a hosted deployment, Foundry injects this for
# you, but only after you create an Application Insights resource and attach it
# to the project as a connection. See "Attach Application Insights" and "Read the
# policy decisions in Application Insights" in the README. azd does not create
# that resource.
# APPLICATIONINSIGHTS_CONNECTION_STRING=InstrumentationKey=...
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# =============================================================================
# 2. ASSERT target (which HelpdeskBot the evaluation calls)
# =============================================================================
# local  (default) runs the guarded agent in this process. No deployment needed.
# hosted calls the deployed Hosted Agent. Live, billable, and it executes the
#        agent's real tools, so point it only at a fixture-backed deployment.
# ASSERT_TARGET_MODE=local
# Deployed agent's Responses endpoint, printed by `azd deploy`. Required when
# ASSERT_TARGET_MODE=hosted. Authentication uses DefaultAzureCredential, so run `az login`
# first and no key belongs in this file.
# FOUNDRY_AGENT_ENDPOINT=https://your-resource.services.ai.azure.com/api/projects/your-project/agents/helpdeskbot/endpoint/protocols/openai/responses
# Optional: a hosted session created for the exact candidate agent version.
# Session affinity does not replace ASSERT's explicit conversation-history replay.
# FOUNDRY_AGENT_SESSION_ID=

# =============================================================================
# 3. ASSERT pipeline model (systematize, tester, judge)
# =============================================================================
# eval_config.yaml calls azure/gpt-5.4-mini through LiteLLM for every pipeline
# stage. These credentials are separate from the agent above: they belong to the
# evaluator, not to the model under test.
# AZURE_API_BASE=https://your-resource.openai.azure.com
# AZURE_API_VERSION=2025-04-01-preview
# Option A: API key.
# AZURE_API_KEY=
# Option B: Entra ID, which this sample uses because the Foundry resource
# disables local key auth. Requires the assert-ai [azure-aad] extra and the
# Cognitive Services OpenAI User role.
# ASSERT_AZURE_USE_AAD=1
